# Bot token from the Discord Developer Portal (Bot > Token).
# Use the test bot's token while developing.
DISCORD_TOKEN=

# Application ID from the Developer Portal (General Information).
DISCORD_APPLICATION_ID=

# ID of the server the bot runs in. Slash commands are registered only there.
DISCORD_GUILD_ID=

# Channel the bot posts Assignments and completions in (#chores).
CHORES_CHANNEL_ID=

# Channel the bot posts admin logs, warnings and backups in (#bot-admin).
ADMIN_CHANNEL_ID=

# IANA timezone of the house. Optional; defaults to America/Los_Angeles.
TIMEZONE=America/Los_Angeles

# "true" only in the test server: enables the /dev commands. Optional; defaults to false.
IS_TEST_SERVER=false
